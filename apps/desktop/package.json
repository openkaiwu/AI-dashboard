{
  "name": "aihub-desktop",
  "version": "1.0.1",
  "description": "AI Hub Codex quota companion",
  "homepage": "http://127.0.0.1:8080",
  "author": {
    "name": "AI Hub",
    "email": "318460916+openkaiwu@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . AIHub --platform=win32 --arch=x64 --out=../../artifacts/desktop --overwrite --prune=true --ignore=package-lock.json",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.aihub.desktop",
    "productName": "AI Hub",
    "directories": {
      "output": "../../artifacts/desktop/installer"
    },
    "files": [
      "**/*",
      "!resources/bin/**"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": ["**/*"]
      },
      {
        "from": "resources/bridge.example.json",
        "to": "bridge.example.json"
      },
      {
        "from": "resources/app-config.json",
        "to": "app-config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.png",
      "category": "Utility",
      "artifactName": "AIHub-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "AIHub-${version}-x86_64.AppImage"
    },
    "deb": {
      "artifactName": "AIHub-${version}-amd64.deb",
      "category": "Utility"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ],
      "icon": "icon.icns",
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "AIHub-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "AIHub-${version}-arm64.dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Hub",
      "installerLanguages": ["zh_CN", "en_US"],
      "artifactName": "AIHub-Setup-${version}.${ext}",
      "runAfterFinish": true
    }
  }
}
