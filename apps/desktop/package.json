{
  "name": "aihub-desktop",
  "version": "1.1.12",
  "description": "AI Hub Codex quota companion",
  "homepage": "http://127.0.0.1:8080",
  "author": {
    "name": "AI Hub",
    "email": "318460916+openkaiwu@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . AIHub --platform=win32 --arch=x64 --out=../../artifacts/desktop --overwrite --prune=true --ignore=package-lock.json",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.aihub.desktop",
    "productName": "AI Hub",
    "directories": {
      "output": "../../artifacts/desktop/installer"
    },
    "files": [
      "**/*",
      "!resources/bin/**",
      "!resources/ui/**",
      "!**/*.test.cjs",
      "!mode-preference.json",
      "!**/*.protected*",
      "!**/*.env",
      "!**/*.pem",
      "!**/*.key",
      "!**/*.pfx",
      "!**/*.p12",
      "!**/*.log"
    ],
    "extraResources": [
      {
        "from": "resources/ui",
        "to": "ui"
      },
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/bridge.example.json",
        "to": "bridge.example.json"
      },
      {
        "from": "resources/app-config.json",
        "to": "app-config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Utility",
      "artifactName": "AIHub-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "AIHub-${version}-linux-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "AIHub-${version}-linux-${arch}.deb",
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.icns",
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "AIHub-${version}-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "AIHub-${version}-${arch}.dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Hub",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "artifactName": "AIHub-正式版v${version}.${ext}",
      "runAfterFinish": true,
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  }
}
