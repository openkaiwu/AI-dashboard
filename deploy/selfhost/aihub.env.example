# AI Hub self-host environment (copy to aihub.env; referenced by aihub.service)
AIHUB_ADDR=127.0.0.1:8080
AIHUB_DATABASE_URL=postgres://aihub:CHANGE_ME@127.0.0.1:5432/aihub?sslmode=disable
# Comma-separated origins allowed to call the API from a browser.
AIHUB_ALLOWED_ORIGINS=https://aihub.example.com
# Set to a directory to have GET /api/v1/admin/operations report the latest
# backup produced by scripts/backup.sh (which also reads this variable).
AIHUB_BACKUP_DIR=/opt/aihub/backups
# AIHUB_WEB_DIST=/opt/aihub/web/dist
# AIHUB_MIGRATE_ONLY=1
